# =============================================================================
# profesional-astro — Strapi dev environment (mirrors root .env)
# =============================================================================
# Copy this file to `strapi/.env` and (optionally) replace the dev secrets
# with random values:
#   cp strapi/.env.example strapi/.env
#
# Generate strong random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Notes:
#   - This file is SAFE to commit. It only contains placeholders + the same
#     DATABASE_URL the root `.env` uses.
#   - Real `strapi/.env` is gitignored.
#   - In dev, the placeholder secrets here are FINE — Strapi only refuses
#     to start if the values are missing entirely, not if they are weak.
# =============================================================================


# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337


# ── Secrets (placeholders are fine for dev) ───────────────────────────────
# In production, replace each of these with a random base64 string.
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=devKey1,devKey2
API_TOKEN_SALT=dev_api_token_salt_replace_in_prod
ADMIN_JWT_SECRET=dev_admin_jwt_secret_replace_in_prod
JWT_SECRET=dev_jwt_secret_replace_in_prod
TRANSFER_TOKEN_SALT=dev_transfer_token_salt_replace_in_prod


# ── Database (matches docker-compose.yml in repo root) ────────────────────
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://postgres:prisma@localhost:5433/postgres?schema=public
DATABASE_SSL=false
