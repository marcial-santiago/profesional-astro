---
import HeaderLink from "./HeaderLink.astro";
import Button from "../components/Button/index.astro";
import LogoSrc from "../assets/logoroldans.jpg";
import { SERVICE_DATA } from "../consts";

const moduleColors: Record<string, string> = {
  cleaning: "bg-sky-500",
  gardening: "bg-emerald-500",
  concreting: "bg-amber-500",
  removalist: "bg-red-700",
};
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto flex items-center px-6 py-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 mr-10 group">
      <img
        src={LogoSrc.src}
        alt="Roldans"
        class="h-10 w-auto rounded-lg shrink-0"
      />
      <div class="flex flex-col leading-tight">
        <span class="text-2xl font-bold text-white tracking-tight">Roldans</span
        >
        <span
          class="text-[10px] text-white/50 tracking-[0.2em] uppercase font-medium"
          >Multiservices</span
        >
      </div>
    </a>

    <!-- Nav links -->
    <div class="hidden md:flex items-center gap-1 flex-1">
      <HeaderLink
        class="px-6 py-3 rounded-lg text-white/90 hover:text-white hover:bg-white/10 transition-all duration-200 text-2xl font-medium"
        href="/#home">Home</HeaderLink
      >
      <div class="relative group">
        <span
          class="px-6 py-3 rounded-lg text-white/90 hover:text-white hover:bg-white/10 transition-all duration-200 text-2xl font-medium cursor-default flex items-center gap-2 select-none"
        >
          Services
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform duration-200 group-hover:rotate-180"
            ><polyline points="6 9 12 15 18 9"></polyline></svg
          >
        </span>
        <div
          class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0"
        >
          <div
            class="bg-slate-900/95 backdrop-blur-sm border border-white/10 rounded-xl py-3 min-w-60 shadow-xl"
          >
            {
              SERVICE_DATA.services.map((s) => {
                const dotColor = moduleColors[s.nameUrl] || "bg-sky-500";
                return (
                  <a
                    href={`/services/${s.nameUrl}`}
                    class="flex items-center gap-3 px-5 py-3 text-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors"
                  >
                    <span class={`w-2.5 h-2.5 rounded-full ${dotColor} shrink-0`} />
                    {s.sectionTitle}
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>
      <HeaderLink
        class="px-6 py-3 rounded-lg text-white/90 hover:text-white hover:bg-white/10 transition-all duration-200 text-2xl font-medium"
        href="/#about">About Us</HeaderLink
      >
      <HeaderLink
        class="px-6 py-3 rounded-lg text-white/90 hover:text-white hover:bg-white/10 transition-all duration-200 text-2xl font-medium"
        href="/#contact">Contact</HeaderLink
      >
    </div>

    <!-- Phone + CTA -->
    <div class="ml-auto flex items-center gap-4">
      <a
        href="tel:0427 441 139"
        class="hidden lg:flex items-center gap-2 text-white/90 hover:text-white text-base font-medium transition-colors"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        0427 441 139
      </a>
      <a
        href="/#contact"
        class="inline-flex items-center justify-center px-6 h-12 rounded-xl bg-white text-[var(--accent-600)] text-base font-bold shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200"
      >
        Get a Quote
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("main-header")!;

  function updateHeader() {
    if (window.scrollY > 60) {
      header.classList.add(
        "bg-[var(--accent-600)]/95",
        "backdrop-blur-sm",
        "shadow-lg",
      );
    } else {
      header.classList.remove(
        "bg-[var(--accent-600)]/95",
        "backdrop-blur-sm",
        "shadow-lg",
      );
    }
  }

  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();
</script>
