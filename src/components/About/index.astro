---
import Button from "../Button/index.astro";

const features = [
    {
      title: "Serving All Queensland",
      desc: "Brisbane, Gold Coast, Sunshine Coast and surrounding areas — we cover it all.",
      icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    },
    {
      title: "Quality Guaranteed",
      desc: "We stand behind our work and guarantee the quality of every service we deliver.",
      icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
    },
    {
      title: "Honest & Reliable",
      desc: "Built on long-lasting relationships through honesty, reliability, and attention to detail.",
      icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    },
    {
      title: "Customer First",
      desc: "Your satisfaction is at the heart of everything we do. Every job completed to the highest standard.",
      icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    },
];
---

<section class="bg-white py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Left: text -->
      <div>
        <p class="text-sky-600 font-semibold text-sm uppercase tracking-widest mb-3">Who We Are</p>
        <h2 class="text-4xl md:text-5xl font-bold text-slate-900 leading-tight mb-6">
          Over 15 years of trusted service across Queensland
        </h2>
        <p class="text-slate-500 text-lg leading-relaxed mb-6">
          At Roldans Multiservices, we have proudly provided reliable and professional house maintenance services across Queensland for more than 15 years. Our goal is simple: to help homeowners and businesses maintain their properties with high-quality workmanship and exceptional customer service.
        </p>
        <p class="text-slate-500 text-lg leading-relaxed mb-10">
          We offer a wide range of services, including cleaning, gardening, concreting, removalist services, and handyman solutions. Whether it's a small repair, a property clean-up, or a larger maintenance project, our experienced team is committed to delivering outstanding results every time.
        </p>

        <!-- Features grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {features.map((f) => (
            <div class="flex gap-4">
              <div class="w-11 h-11 bg-sky-50 rounded-xl flex items-center justify-center text-sky-600 shrink-0">
                <Fragment set:html={f.icon} />
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">{f.title}</h3>
                <p class="text-slate-500 text-sm leading-relaxed">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: stats card -->
      <div class="relative">
        <div class="bg-slate-900 rounded-3xl p-10 text-white">
          <p class="text-slate-400 text-sm uppercase tracking-widest mb-8">Our track record</p>

          <div class="grid grid-cols-2 gap-8 mb-10">
            <div>
              <p class="text-5xl font-bold text-white mb-1">15<span class="text-sky-400">+</span></p>
              <p class="text-slate-400 text-sm">Years serving QLD</p>
            </div>
            <div>
              <p class="text-5xl font-bold text-white mb-1">1000<span class="text-sky-400">+</span></p>
              <p class="text-slate-400 text-sm">Happy clients</p>
            </div>
            <div>
              <p class="text-5xl font-bold text-white mb-1">4</p>
              <p class="text-slate-400 text-sm">Service categories</p>
            </div>
            <div>
              <p class="text-5xl font-bold text-white mb-1">7<span class="text-sky-400">d</span></p>
              <p class="text-slate-400 text-sm">Available all week</p>
            </div>
          </div>

          <!-- Testimonial -->
          <div class="border-t border-slate-700 pt-8">
            <p class="text-slate-300 italic text-sm leading-relaxed mb-4">
              "Roldans transformed our overgrown garden into a beautiful outdoor space. Professional, reliable, and the results speak for themselves. Highly recommend!"
            </p>
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-sky-500 rounded-full flex items-center justify-center text-white font-bold text-sm">J</div>
              <div>
                <p class="text-white font-semibold text-sm">James T.</p>
                <p class="text-slate-500 text-xs">Gold Coast, QLD</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Decorative accent -->
        <div class="absolute -top-4 -right-4 w-24 h-24 bg-sky-500/10 rounded-full blur-2xl -z-10"></div>
        <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-sky-500/10 rounded-full blur-2xl -z-10"></div>
      </div>
    </div>
  </div>
</section>

<!-- CTA Banner -->
<section class="bg-sky-600 py-16 px-6">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
    <div>
      <h2 class="text-3xl font-bold text-white mb-2">Let's take care of your property</h2>
      <p class="text-sky-100">Contact us today for a free quote — we'll respond within 24 hours.</p>
    </div>
    <div class="shrink-0">
      <a href="/#contacto" class="inline-flex items-center justify-center px-8 h-14 rounded-xl bg-white text-[var(--accent-600)] text-lg font-bold shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-200 cursor-pointer">
        Get a Free Quote
      </a>
    </div>
  </div>
</section>
