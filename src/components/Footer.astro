---
import LogoSrc from "../assets/logoroldans.jpg";
const today = new Date();
---

<footer class="bg-slate-900 text-white pt-10 pb-6">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-3">
          <img
            src={LogoSrc.src}
            alt="Roldans"
            class="h-9 w-auto rounded-lg shrink-0"
          />
          <div class="flex flex-col leading-tight">
            <span class="text-xl font-bold tracking-tight">Roldans</span>
            <span
              class="text-[10px] text-white/40 tracking-[0.2em] uppercase font-medium"
              >Multiservices</span
            >
          </div>
        </a>
        <p class="text-slate-400 text-xs leading-relaxed mb-4">
          Professional cleaning, gardening, concreting and removalist services
          across Queensland.
        </p>
        <div
          class="bg-slate-800/60 border border-slate-750/50 rounded-lg p-3 text-xs space-y-2"
        >
          <div class="flex items-center justify-between gap-2">
            <span class="flex items-center gap-1.5 font-medium text-slate-300">
              <span class="relative flex h-2 w-2 shrink-0">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
                ></span>
              </span>
              Office Hours
            </span>
            <span class="text-white font-semibold text-[11px]"
              >Mon–Sat 7am–6pm</span
            >
          </div>
          <div
            class="flex items-center justify-between gap-2 border-t border-slate-700/50 pt-2"
          >
            <span class="flex items-center gap-1.5 text-slate-300">
              <span>🛠️ On-Site Trades</span>
            </span>
            <span class="text-emerald-400 font-semibold text-[11px]"
              >24/7 Available</span
            >
          </div>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-widest text-slate-400 mb-5"
        >
          Navigation
        </h3>
        <ul class="flex flex-col gap-3">
          {
            [
              { href: "/#home", label: "Home" },
              { href: "/#services", label: "Our Services" },
              { href: "/#about", label: "About Us" },
              { href: "/#book-visit", label: "Book a Visit" },
              { href: "/#contact", label: "Contact" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 hover:text-white text-sm transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-widest text-slate-400 mb-5"
        >
          Services
        </h3>
        <ul class="flex flex-col gap-3">
          {
            [
              { href: "/services/cleaning", label: "Cleaning Services" },
              { href: "/services/gardening", label: "Gardening Services" },
              { href: "/services/concreting", label: "Concreting Services" },
              { href: "/services/removalist", label: "Removalist Services" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 hover:text-white text-sm transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-widest text-slate-400 mb-5"
        >
          Contact
        </h3>
        <ul class="flex flex-col gap-4">
          <li>
            <a
              href="tel:0427 441 139"
              class="flex items-start gap-3 text-slate-400 hover:text-white transition-colors group"
            >
              <svg
                class="mt-0.5 shrink-0"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
              <span class="text-sm">0427 441 139</span>
            </a>
          </li>
          <li>
            <a
              href="mailto:quotations@roldans.com.au"
              class="flex items-start gap-3 text-slate-400 hover:text-white transition-colors"
            >
              <svg
                class="mt-0.5 shrink-0"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span class="text-sm break-all">quotations@roldans.com.au</span>
            </a>
          </li>
          <li class="flex items-start gap-3 text-slate-400">
            <svg
              class="mt-0.5 shrink-0"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
            </svg>
          </li>
        </ul>
      </div>

      <!-- Bottom bar -->
      <div
        class="border-t border-slate-800 pt-5 flex flex-col sm:flex-row items-center justify-between gap-3"
      >
        <p class="text-slate-500 text-sm">
          &copy; {today.getFullYear()} Roldans. All rights reserved.
        </p>
        <div class="flex items-center gap-1">
          <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
          <span class="text-slate-500 text-xs"
            >Licensed & Insured in Australia</span
          >
        </div>
      </div>
    </div>
  </div>
</footer>
