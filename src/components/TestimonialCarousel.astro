---
interface Testimonial {
  text: string;
  author: string;
  initial?: string;
}

interface Props {
  testimonials?: Testimonial[];
  autoplayInterval?: number;
}

const defaultTestimonials: Testimonial[] = [
  {
    text: "Camilo did a fantastic job cleaning carpets and upholstered furniture. He rang the day before to plan for the job. Arrived on time and set about the work. The carpets and lounges can me up so well. Camilo checked in through the job to see we were happy with each chair. He was great.",
    author: "Scott F.",
  },
  {
    text: "Cam did an excellent job! He is the best experience I ever have. His quote is very reasonable i will never doubt. They were prompt, professional, and communicated clearly throughout the entire process. The work was completed to a very high standard, with great attention to detail. Highly recommended. I would happily hire them again for future tasks!",
    author: "Scott F.",
  },
  {
    text: "Very nice team and does the job completely",
    author: "Daisy L.",
  },
  {
    text: "Amazing work, went above and beyond to ensure the carpets were perfect for our bond clean. Highly recommend!",
    author: "Rob G.",
  },

  {
    text: "Reliable and completed the work to a high standard.",
    author: "Junio P.",
  },
  {
    text: "Awesome work! Will definitely use again",
    author: "Ethan G.",
  },
  {
    text: "On time super efficient and great communicartion. 10/10 thank you!🙏",
    author: "Ben P.",
  },
];

const avatarColors = [
  "bg-sky-500",
  "bg-emerald-500",
  "bg-amber-500",
  "bg-indigo-500",
  "bg-rose-500",
  "bg-teal-500",
  "bg-violet-500",
  "bg-orange-500",
];

const { testimonials = defaultTestimonials, autoplayInterval = 5000 } = Astro.props;
---

<div
  class="border-t border-slate-700 pt-5 testimonial-carousel relative"
  data-interval={autoplayInterval}
>
  <!-- Grid container for stacked slides -->
  <div class="grid grid-cols-1 grid-rows-1 mb-2">
    {
      testimonials.map((item, index) => {
        const colorClass = avatarColors[index % avatarColors.length];
        return (
          <div
            class={`testimonial-slide col-start-1 row-start-1 flex flex-col justify-between transition-all duration-500 ease-out ${
              index === 0
                ? "opacity-100 translate-y-0 pointer-events-auto z-10"
                : "opacity-0 translate-y-2 pointer-events-none z-0"
            }`}
            data-index={index}
          >
            <p class="text-slate-300 italic text-sm leading-relaxed mb-3">
              "{item.text}"
            </p>
            <div class="flex items-center gap-3">
              <div
                class={`w-9 h-9 ${colorClass} rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-sm transition-colors duration-300`}
              >
                {item.initial || item.author.charAt(0)}
              </div>
              <div>
                <p class="text-white font-semibold text-sm">{item.author}</p>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- Shared dots navigation bar (outside the slides loop) -->
  {
    testimonials.length > 1 && (
      <div class="flex items-center justify-end gap-1.5 pt-2">
        {testimonials.map((_, i) => (
          <button
            type="button"
            class={`testimonial-dot h-2 rounded-full transition-all duration-300 ${
              i === 0 ? "bg-sky-400 w-5" : "bg-slate-600 w-2 hover:bg-slate-400"
            }`}
            data-slide={i}
            aria-label={`Go to testimonial ${i + 1}`}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll(".testimonial-carousel").forEach((carousel) => {
    const slides = carousel.querySelectorAll<HTMLElement>(".testimonial-slide");
    const dots =
      carousel.querySelectorAll<HTMLButtonElement>(".testimonial-dot");
    const intervalTime = Number(carousel.getAttribute("data-interval")) || 5000;

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: ReturnType<typeof setInterval>;

    function goToSlide(index: number) {
      if (index === currentIndex) return;

      // Update outgoing slide
      slides[currentIndex].classList.remove(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto",
        "z-10",
      );
      slides[currentIndex].classList.add(
        "opacity-0",
        "translate-y-2",
        "pointer-events-none",
        "z-0",
      );

      // Update current index
      currentIndex = (index + slides.length) % slides.length;

      // Update incoming slide
      slides[currentIndex].classList.remove(
        "opacity-0",
        "translate-y-2",
        "pointer-events-none",
        "z-0",
      );
      slides[currentIndex].classList.add(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto",
        "z-10",
      );

      // Sync active state for ALL dots
      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.remove("bg-slate-600", "w-2");
          dot.classList.add("bg-sky-400", "w-5");
        } else {
          dot.classList.remove("bg-sky-400", "w-5");
          dot.classList.add("bg-slate-600", "w-2");
        }
      });
    }

    function startAutoplay() {
      timer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, intervalTime);
    }

    function resetAutoplay() {
      clearInterval(timer);
      startAutoplay();
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const slideIndex = Number(dot.getAttribute("data-slide"));
        goToSlide(slideIndex);
        resetAutoplay();
      });
    });

    startAutoplay();
  });
</script>
