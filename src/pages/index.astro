---
import About from "../components/About/index.astro";
import BannerPrincipal from "../components/BannerPrincipal/index.astro";
import PrincipalForm from "../components/PrincipalForm/index.astro";
import ServicesCards from "../components/ServicesCards/index.astro";
import VisitScheduler from "../components/VisitScheduler.astro";
import { STRAPI_URL, normalizeStrapiMedia, strapiQuery } from "../config";
import BaseLayaout from "../layouts/BaseLayaout.astro";

interface WorkTypeImage {
  url?: string | null;
  alternativeText?: string | null;
  width?: number | null;
  height?: number | null;
}

interface StrapiWorkType {
  id: number;
  name: string;
  slug: string;
  description: string | null;
  category: string;
  duration: number;
  price: number;
  isActive: boolean;
  image: WorkTypeImage | null;
}

// Fetch active services grouped by category from Strapi
const workTypesQuery = strapiQuery({
  "populate[image][fields][0]": "url",
  "populate[image][fields][1]": "alternativeText",
  "populate[image][fields][2]": "width",
  "populate[image][fields][3]": "height",
  "filters[isActive][$eq]": true,
  "sort[0]": "category:asc",
  "sort[1]": "name:asc",
});
let strapiWorkTypes: StrapiWorkType[] = [];
try {
  const res = await fetch(`${STRAPI_URL}/api/work-types?${workTypesQuery}`);
  if (res.ok) {
    const strapiData = await res.json();
    strapiWorkTypes = strapiData.data || [];
  }
} catch (error) {
  console.warn("Strapi backend is unreachable, proceeding with empty workTypes array:", error);
}

// Transform Strapi response to match existing format
const workTypes = strapiWorkTypes.map((wt) => {
  const media = normalizeStrapiMedia(wt.image, wt.name);
  return {
    id: wt.id,
    name: wt.name,
    slug: wt.slug,
    description: wt.description,
    category: wt.category,
    duration: wt.duration,
    price: wt.price,
    isActive: wt.isActive,
    image: media ? { path: media.url } : null,
  };
});

type WorkType = (typeof workTypes)[number];
const grouped = workTypes.reduce(
  (acc: Record<string, WorkType[]>, wt: WorkType) => {
    if (!acc[wt.category]) acc[wt.category] = [];
    acc[wt.category].push(wt);
    return acc;
  },
  {} as Record<string, WorkType[]>,
);
---

<BaseLayaout>
  <section id="home">
    <BannerPrincipal />
  </section>
  <section id="services">
    <ServicesCards grouped={grouped} />
  </section>
  <section id="about">
    <About />
  </section>
  <section id="book-visit" class="py-24 bg-slate-100/90 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4">
      <div class="reveal text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl mb-4">
          Book Your Visit
        </h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Pick a service and time that works for you. We'll confirm your
          appointment right away.
        </p>
      </div>
      <div class="reveal delay-200">
        <VisitScheduler />
      </div>
    </div>
  </section>
  <section id="contact">
    <PrincipalForm />
  </section>
</BaseLayaout>
