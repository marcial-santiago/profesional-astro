---
import BlogPost from '../../layouts/BlogPost.astro';
import { STRAPI_URL, normalizeStrapiMedia, strapiQuery } from '../../config';

export const prerender = false;

interface StrapiBlogPost {
  id: number;
  title: string;
  slug: string;
  description: string;
  pubDate: string;
  updatedDate: string | null;
  content: string;
  heroImage: {
    url?: string | null;
    alternativeText?: string | null;
    width?: number | null;
    height?: number | null;
  } | null;
}

const { slug } = Astro.params;

const blogDetailQuery = strapiQuery({
  "filters[slug][$eq]": slug || "",
  "populate[heroImage][fields][0]": "url",
  "populate[heroImage][fields][1]": "alternativeText",
  "populate[heroImage][fields][2]": "width",
  "populate[heroImage][fields][3]": "height",
});
const res = await fetch(`${STRAPI_URL}/api/blog-posts?${blogDetailQuery}`);
const data = await res.json();
const post: StrapiBlogPost | undefined = data.data?.[0];

if (!post) {
  return Astro.redirect("/404");
}

const { title, description, pubDate, heroImage, content } = post;
const heroMedia = normalizeStrapiMedia(heroImage, title);
---

<BlogPost title={title} description={description} pubDate={new Date(pubDate)} heroImage={heroMedia?.url}>
  <Fragment set:html={content} />
</BlogPost>
