# =============================================================================
# profesional-astro — Development Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env          # macOS / Linux / Git Bash
#   copy .env.example .env        # Windows cmd / PowerShell
#
# Notes:
#   - This file is SAFE to commit. It only contains placeholders.
#   - Never commit a real `.env`. It is already in `.gitignore`.
#   - After changing this file, restart `pnpm run dev:up` (or the dev server
#     you have running) so the new values are picked up.
# =============================================================================


# ── Database (PostgreSQL via Docker) ────────────────────────────────────────
# Matches the credentials in `docker-compose.yml`. Strapi will read this
# when `DATABASE_URL` is set, otherwise it falls back to discrete vars.
DATABASE_URL=postgresql://postgres:prisma@localhost:5433/postgres?schema=public
DATABASE_CLIENT=postgres
DATABASE_SSL=false


# ── Strapi CMS ──────────────────────────────────────────────────────────────
# Where the Astro frontend reaches the Strapi API (server-side, internal).
# In local dev this is the same port Strapi listens on.
STRAPI_URL=http://localhost:1337

# Public-facing Strapi origin used to render image/upload URLs in HTML.
# In production behind nginx, this is usually the same-origin proxy path
# (e.g. /strapi). For local dev, keep it equal to STRAPI_URL.
PUBLIC_STRAPI_URL=http://localhost:1337

# Optional. Create in Strapi admin (Settings → API Tokens) if you start
# protecting public routes. Leave empty for the default open setup.
STRAPI_API_TOKEN=


# ── Stripe (payments) ───────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/test/apikeys
# Use `sk_test_*` and `pk_test_*` for local development.
STRIPE_SECRET_KEY=sk_test_replace_me
PUBLIC_STRIPE_KEY=pk_test_replace_me

# Get this with:  stripe listen --forward-to localhost:4321/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public base URL Stripe redirects to after checkout. Used by the Astro
# endpoints that build success/cancel URLs.
STRIPE_API_URL=http://localhost:4321


# ── App security ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CSRF / CORS validation.
# No spaces. Include any local port you actually hit the frontend from.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:1337

# Timezone for date/time validation and display (IANA format).
# Examples: America/Argentina/Buenos_Aires, America/New_York, Europe/Madrid
APP_TIMEZONE=America/Argentina/Buenos_Aires


# ── Optional integrations ───────────────────────────────────────────────────
# Google Maps embed URL (Maps → Share → Embed a map). Paste the full
# `src` URL from the iframe code Google gives you.
GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=


# ── Admin / session secrets (used by server endpoints) ──────────────────────
# These are only consumed if you wire them up in the auth layer. Safe to
# leave as placeholders in dev — production should set real random values.
ADMIN_USER=admin
ADMIN_PASSWORD=supersegura123
ADMIN_SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars
