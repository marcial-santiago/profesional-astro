# ── Production Environment Variables ──
# Copy this file to .env on the server, fill CHANGE_ME values, then run:
#   docker compose -f docker-compose.prod.yml up -d --build

# ── Public ports ──
HTTP_PORT=80
STRAPI_PORT=1337

# ── Database (PostgreSQL container) ──
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_strong_database_password
DB_NAME=profesional_astro

# ── Strapi secrets ──
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=CHANGE_ME_key1,CHANGE_ME_key2,CHANGE_ME_key3,CHANGE_ME_key4
API_TOKEN_SALT=CHANGE_ME_random_api_token_salt
ADMIN_JWT_SECRET=CHANGE_ME_random_admin_jwt_secret
JWT_SECRET=CHANGE_ME_random_jwt_secret
TRANSFER_TOKEN_SALT=CHANGE_ME_random_transfer_token_salt

# ── Astro ↔ Strapi ──
# Internal Docker URL. Do not change unless service names change.
STRAPI_URL=http://strapi:1337
# Browser-facing Strapi URL for images/uploads rendered by Astro.
PUBLIC_STRAPI_URL=/strapi
# Optional; create in Strapi admin after first boot if you later protect public routes.
STRAPI_API_TOKEN=

# ── Stripe ──
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
PUBLIC_STRIPE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── App security ──
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_SESSION_SECRET=CHANGE_ME_random_long_string_at_least_32_chars
# Comma-separated, no spaces. Include your final public URL.
ALLOWED_ORIGINS=https://tu-dominio.com,http://tu-dominio.com

# ── Optional ──
APP_TIMEZONE=America/Argentina/Buenos_Aires
GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=CHANGE_ME
